# Copy this file to .env on the Raspberry Pi and fill in strong values.
# .env is ignored by git.

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Shared token checked against the ESP32 payload.
# NOTE: this token is transmitted over plain HTTP by design (pedagogical flaw).
ESP_TOKEN=

# Cookie flag — set to "1" once the dashboard is served over HTTPS (Nginx + self-signed cert).
SESSION_COOKIE_SECURE=0

# Number of trusted reverse-proxy hops in front of gunicorn.
#   1 = Pi's own nginx only (default, local access via bpem.local)
#   2 = public-facing proxy on another host → Pi's nginx → gunicorn
PROXY_HOPS=1
