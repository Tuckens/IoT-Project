# Copy this file to .env on the Raspberry Pi and fill in strong values.
# .env is ignored by git.

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Shared HMAC-SHA256 key used to verify signatures from the ESP32. The
# SAME value must be compiled into esp-code/creds.h as `hmac_key`.
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
#
# NOTE (pedagogical flaw): the channel ESP->Pi remains plain HTTP. The
# HMAC key never travels on the wire, but an attendee who captures a
# (body, X-ESP-Signature) pair can REPLAY it to the server, or dump the
# ESP32 flash to extract this key and forge arbitrary payloads.
ESP_HMAC_KEY=

# Cookie flag — set to "1" once the dashboard is served over HTTPS (Nginx + self-signed cert).
SESSION_COOKIE_SECURE=0

# Number of trusted reverse-proxy hops in front of gunicorn.
#   1 = Pi's own nginx only (default, local access via bpem.local)
#   2 = public-facing proxy on another host → Pi's nginx → gunicorn
PROXY_HOPS=1
